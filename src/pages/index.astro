  <!--
    CARTA (antes era la página /carta, ahora vive dentro de Inicio)
    ================================================================
    Genera dinámicamente el menú a partir de un archivo JSON,
    organizando las categorías en secciones navegables con scroll
    suave y navegación sticky.
  -->
  <section id="carta" class="menu">

    <!-- 
      NAVEGACIÓN STICKY DE CATEGORÍAS
      ================================================================
      Barra horizontal scrolleable que se mantiene fija en la parte 
      superior. Cada chip es clickeable y muestra el icono de categoría.
    -->
    <nav class="menu-nav sticky-header" aria-label="Categorías de la carta">
      <ul>
        {categories.map((c) => (
          <li>
            <a href={`#${c.id}`}>
              {/* Icono de categoría si existe */}
              {c.iconPath && (
                <span class="chip__icon" aria-hidden="true">
                  <img 
                    src={c.iconPath} 
                    alt="" 
                    loading="lazy" 
                    decoding="async" 
                  />
                </span>
              )}
              <span class="chip__label">{c.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- 
      SECCIONES DE CATEGORÍAS
      ================================================================
      Cada sección corresponde a una categoría del menú y contiene
      sus items organizados.
    -->
    {categories.map((c) => (
      <section id={c.id} class="category-section">
        
        {/* Título de sección con icono */}
        <h2>
          {c.iconPath && (
            <img 
              class="cat-icon" 
              src={c.iconPath} 
              alt="" 
              loading="lazy" 
              decoding="async" 
            />
          )}
          {c.label}
        </h2>

        {/* Descripción de categoría si existe */}
        {c.description && (
          <p class="category-description">{c.description}</p>
        )}

        {/* Lista de items de la categoría */}
        <ul>
          {c.items.map((raw) => {
            const it = normalizeItem(raw);
            return (
              <li class="menu-item">
                
                {/* Cabecera del item: nombre + precio simple */}
                <div class="item-header">
                  <strong>
                    {/* Icono del item si existe */}
                    {it.iconPath && (
                      <img 
                        class="item-icon" 
                        src={it.iconPath} 
                        alt="" 
                        loading="lazy" 
                        decoding="async" 
                      />
                    )}
                    {it.name}
                    {/* Badge si es nuevo u especial */}
                    {it.badge && (
                      <span class="badge badge--new">{it.badge}</span>
                    )}
                  </strong>

                  {/* Precio simple (solo si no tiene múltiples opciones) */}
                  {it.priceSingle && (
                    <span class="single-price">{it.priceSingle}</span>
                  )}
                </div>

                {/* Precios múltiples (ej: Media ración / Ración completa) */}
                {it.priceMulti && (
                  <ul class="multi-price">
                    {it.priceMulti.map(([portion, price]) => (
                      <li>
                        <span class="portion">{portion}</span>
                        <span class="price">{price}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {/* Descripción del item si existe */}
                {it.description && (
                  <p class="item-description">{it.description}</p>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </section>

  <!-- 
    FUNCIONALIDAD JAVASCRIPT DE LA CARTA
    ================================================================
    Script que maneja:
    - Scroll suave entre secciones
    - Scrollspy (activación automática de pestañas)
    - Navegación horizontal automática de chips
    - Cálculo dinámico de alturas sticky
    - Intersection Observer para resaltado de secciones
  -->
  <script is:inline>
  (function () {
    // Detecta preferencia de movimiento reducido
    const prefersNoMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Selecciona elementos clave del DOM
    const siteHeader = document.querySelector('.site-header');
    const chipsNav = document.querySelector('.menu-nav.sticky-header');
    const navLinks = Array.from(document.querySelectorAll('.menu-nav a[href^="#"]'));
    const sections = Array.from(document.querySelectorAll('.category-section[id]'));

    if (!navLinks.length || !sections.length) return;

    /**
     * GESTIÓN DE ALTURAS DINÁMICAS
     * Expone --chips-h y --sticky-total (usada por scroll-margin-top en el CSS
     * de .category-section) y devuelve el offset total en px.
     */
    const setStickyVars = () => {
      const headerH = siteHeader?.offsetHeight ?? 0;
      const chipsH = chipsNav?.offsetHeight ?? 0;
      const total = headerH + chipsH;

      document.documentElement.style.setProperty('--chips-h', `${chipsH}px`);
      document.documentElement.style.setProperty('--sticky-total', `${total}px`);

      return total;
    };

    /**
     * MAPEADO DE NAVEGACIÓN
     */
    const linksMap = new Map();
    navLinks.forEach((a) => {
      const href = a.getAttribute('href') || '';
      const id = href.startsWith('#') ? href.slice(1) : '';
      if (id) linksMap.set(id, a);
    });

    /**
     * GESTIÓN DE ESTADO ACTIVO (chips de navegación)
     */
    const scrollChipIntoView = (link) => {
      if (!link) return;
      link.scrollIntoView({
        behavior: prefersNoMotion ? 'auto' : 'smooth',
        block: 'nearest',
        inline: 'center',
      });
    };

    let currentActiveId = null;

    const setActive = (id) => {
      if (!id || id === currentActiveId || !linksMap.has(id)) return;
      currentActiveId = id;

      let activeLink = null;
      linksMap.forEach((link, key) => {
        const isActive = key === id;
        link.classList.toggle('active', isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'true');
          activeLink = link;
        } else {
          link.removeAttribute('aria-current');
        }
      });

      if (activeLink) scrollChipIntoView(activeLink);
    };

    /**
     * NAVEGACIÓN POR CLIC
     * Usa scrollIntoView nativo: respeta el scroll-margin-top que ya
     * tienen las .category-section en el CSS, sin cálculos manuales de píxeles.
     */
    let isScrollingFromClick = false;
    let clickTimeout = null;

    navLinks.forEach((a) => {
      a.addEventListener('click', (e) => {
        const href = a.getAttribute('href') || '';
        const id = href.startsWith('#') ? href.slice(1) : '';
        const target = id ? document.getElementById(id) : null;
        if (!target) return;

        e.preventDefault();

        isScrollingFromClick = true;
        setActive(id);
        history.replaceState(null, '', `#${id}`);

        target.scrollIntoView({
          behavior: prefersNoMotion ? 'auto' : 'smooth',
          block: 'start',
        });

        // Vuelve a dejar que el IntersectionObserver mande cuando termine el scroll
        clearTimeout(clickTimeout);
        clickTimeout = setTimeout(() => {
          isScrollingFromClick = false;
        }, 900);
      });
    });

    /**
     * SCROLLSPY - IntersectionObserver como única fuente de verdad
     * Se reconstruye en resize para recalcular el offset del header sticky
     * (importante en móvil, donde el alto del header puede variar).
     */
    let io = null;

    const buildObserver = () => {
      io?.disconnect();
      const offset = setStickyVars();

      io = new IntersectionObserver(
        (entries) => {
          // El callback solo trae las secciones cuyo estado CAMBIÓ en este
          // instante, no la lista completa de lo que está visible ahora mismo.
          // Por eso actualizamos la clase visual con esas entries...
          entries.forEach((entry) => {
            entry.target.classList.toggle('active-section', entry.isIntersecting);
          });

          if (isScrollingFromClick) return;

          // ...pero para decidir el chip activo recalculamos en vivo, sobre
          // TODAS las secciones, cuál de las que están visibles ahora mismo
          // (ya con la clase actualizada arriba) está más arriba en pantalla.
          // Así no dependemos de que en este evento concreto haya llegado
          // una entry "de entrada": siempre miramos el estado real y actual.
          let topId = null;
          let topValue = Infinity;

          sections.forEach((s) => {
            if (s.classList.contains('active-section')) {
              const top = s.getBoundingClientRect().top;
              if (top < topValue) {
                topValue = top;
                topId = s.id;
              }
            }
          });

          if (topId) setActive(topId);
        },
        {
          root: null,
          rootMargin: `-${offset}px 0px -55% 0px`,
          threshold: [0, 0.1, 0.5],
        }
      );

      sections.forEach((s) => io.observe(s));
    };

    buildObserver();

    window.addEventListener('load', buildObserver);
    window.addEventListener('resize', buildObserver);

    // Estado inicial: si se llega con un hash de categoría (ej. /#burgers),
    // lo respetamos. Si no, dejamos que el IntersectionObserver decida en
    // cuanto la carta entre en el viewport (ya no es lo primero que se ve).
    if (location.hash) {
      const id = location.hash.slice(1);
      if (linksMap.has(id)) setActive(id);
    }
  })();
  </script>

  <Reviews />

</BaseLayout>
